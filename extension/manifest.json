{
  "manifest_version": 3,
  "name": "LINE COPILOT",
  "version": "1.2.0",
  "description": "在 LINE Official Account Manager 顯示本機聊天室偵測結果。",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINE COPILOT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manager.line.biz/*",
        "https://chat.line.biz/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css", "accuracy.css"],
      "run_at": "document_idle"
    }
  ]
}
