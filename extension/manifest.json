{
  "manifest_version": 3,
  "name": "LINE COPILOT",
  "version": "1.3.1",
  "description": "在 LINE Official Account Manager 顯示聊天室偵測與 MLM 知識庫建議回覆。",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINE COPILOT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manager.line.biz/*",
        "https://chat.line.biz/*"
      ],
      "js": [
        "config.js",
        "api-client.js",
        "ai-suggestion.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "accuracy.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/fangwl591021/MLM/*"
  ]
}
