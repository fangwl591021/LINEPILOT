{
  "manifest_version": 3,
  "name": "LINE COPILOT",
  "version": "1.4.1",
  "description": "LINE OA 客服操作面板：客戶摘要、快速操作與人工確認的建議回覆。",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINE COPILOT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manager.line.biz/*",
        "https://chat.line.biz/*"
      ],
      "js": [
        "config.js",
        "api-client.js",
        "ai-suggestion.js",
        "copilot-panel.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "accuracy.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/fangwl591021/MLM/*"
  ]
}
